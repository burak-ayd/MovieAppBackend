# ═══════════════════════════════════════════════════════════════════════════
#  MovieApp — ortam değişkenleri
#
#  Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun:
#      copy .env.example .env
#
#  `.env` sürüm kontrolüne girmez. `api/app.py` bu dosyayı başlangıçta okur
#  (`load_dotenv`); `main__.py` de kendi `load_dotenv` çağrısını yapar.
# ═══════════════════════════════════════════════════════════════════════════


# ── Uygulama ───────────────────────────────────────────────────────────────
# Hata ayıklama günlüğü: 1 / true / yes / on / debug
# Kapalıyken `Core.Helpers.Cli.debug_log` hiçbir şey yazmaz.
DEBUG=0


# ── Supabase (kimlik doğrulama + senkronizasyon) ────────────────────────────
# İki değişken ZORUNLUDUR. Dashboard → Project Settings → API bölümünden
# bulunur. Proje adresi `https://<proje>.supabase.co` biçimindedir.

SUPABASE_URL=https://your-project.supabase.co

# GoTrue (kimlik doğrulama) istemci anahtarı — "anon" / "publishable" satırı.
# Yalnızca kayıt, giriş, token yenileme ve çıkış çağrılarında kullanılır.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Sunucu (PostgREST) anahtarı — "service_role" / "secret" satırı.
#
# 🔴 BU ANAHTAR İSTEMCİYE ASLA VERİLMEZ. Mobil uygulamaya, tarayıcıya veya
#    loglara yazılmaz; yalnızca bu sunucunun ortamında kalır.
#
#    user_library / user_documents / user_devices tablolarında RLS açıktır ve
#    hiç politika tanımlı değildir. Bu anahtar olmadan PostgREST sorguları boş
#    döner, yazmalar reddedilir — API 200 dönerken senkronizasyon sessizce
#    hiçbir şey taşımaz. Backend eksik anahtarda açık bir 503 döner.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Veritabanı ─────────────────────────────────────────────────────────────
# supabase/schema_sync.sql içindeki `server_now()` fonksiyonu ZORUNLUDUR.
#
# 🔑 Senkronizasyonun delta karşılaştırması `updated_at > since` üzerine
#    kuruludur ve `updated_at` sütunu veritabanının NOW() değeriyle yazılır.
#    `since` damgası da aynı kaynaktan alınmazsa, iki saat arasındaki kayma
#    sessizce veri kaybına yol açar (bu projede ölçülen kayma: ~0.95 saniye).
#
# Kurulu değilse API çalışmaya devam eder; damga 5 saniye geriye alınarak
# veri kaybı engellenir ve başlangıçta bir kez uyarı basılır. Fonksiyonu
# kurmak bu güvenlik payını tamamen ortadan kaldırır.
#
# Dashboard → SQL Editor'da `supabase/schema_sync.sql` dosyasını çalıştırın.
# 🔑 BURAYA HİÇBİR ŞEY YAZMANIZA GEREK YOKTUR — bu bilinçli bir tasarım.
#
# Supabase token imzalamayı iki şekilde destekler:
#
#   Asimetrik (RSA / ECC P-256 / EdDSA) — önerilen. Token'lar bir `kid`
#   başlığıyla imzalanır, açık anahtarlar projenin JWKS uç noktasında
#   yayımlanır. Doğrulama tamamen yerelde yapılır, ağ turu yoktur.
#
#   Simetrik (HS256, "Legacy JWT Secret") — geriye uyum. Paylaşılan sır
#   JWKS'te YAYIMLANMAZ; bu durumda doğrulama Auth sunucusuna gider.
#
# Backend doğrulamayı SDK'nın `auth.get_claims()` metoduna devreder; o metot
# token'ın `alg`/`kid` başlığına bakıp yolu kendisi seçer. Böylece:
#   • hiçbir imza anahtarını .env'de tutmanız gerekmez,
#   • anahtar döndürme (rotation) ve iptal (revocation) kod değişikliği
#     gerektirmez — JWKS ve `kid` eşleşmesi otomatik takip edilir,
#   • proje ileride asimetrik anahtara geçerse uygulama kendiliğinden
#     ağ turusuz moda düşer, hiçbir şey yapmanız gerekmez.
#
# ⚠️ Panodaki "JWT Signing Keys" listesindeki KEY ID bir KİMLİKTİR, imza
#    anahtarı DEĞİLDİR. Buna ihtiyacınız yoktur; anahtarı hiçbir yere
#    kopyalamayın.
#
# Referans: supabase.com/docs/guides/auth/jwts


# ── Herkese açık adres ──────────────────────────────────────────────────────
# API'nin İSTEMCİLERE gösterdiği taban adres. Sunucu bu adrese istek atmaz;
# yalnızca teşhis mesajlarında (örn. istemci taban URL'e yanlışlıkla /api
# eklediğinde dönen 404 açıklamasında) kullanılır.
#
# ⚠️ Sonuna /api YAZMAYIN. Doğru kullanım:
#     https://movieapi.burakaydogan.net.tr/api/plugins          ✅
#     https://movieapi.burakaydogan.net.tr/api/api/plugins     ❌ 404
#
# Mobil istemci tarafında karşılığı: EXPO_PUBLIC_API_URL
PUBLIC_API_URL=https://movieapi.burakaydogan.net.tr


# ── CORS ───────────────────────────────────────────────────────────────────
# Virgülle ayrılmış origin beyaz listesi. Yalnızca TARAYICI tabanlı istemciler
# için gereklidir; React Native / Expo CORS motoru çalıştırmaz, dolayısıyla
# mobil uygulamanın bu değeri ayarlaması GEREKMEZ.
#
# 🔴 BURAYA API'NİN KENDİ ADRESİ YAZILMAZ — buraya İSTEMCİNİN adresi yazılır
#    (yani tarayıcıda açılan arayüzün origin'i). İkisi karıştırılırsa tarayıcı
#    tabanlı istemci tüm istekleri reddeder.
#
#    Örnek (ayrı bir web arayüzü varsa):
#        CORS_ORIGINS=https://app.burakaydogan.net.tr
#        CORS_ORIGINS=https://panel.burakaydogan.net.tr,https://www.ornek.com
#
# Boş bırakılırsa CORS middleware hiç eklenmez (kapalı — güvenli varsayılan).
# Mobil istemci kullanıyorsanız boş bırakmak doğru seçimdir.
# `*` YAZMAYIN: beyaz listeyi anlamsız kılar ve `allow_credentials` kapalı
# olduğu için işe de yaramaz.
CORS_ORIGINS=


# ── TMDB ────────────────────────────────────────────────────────────────────
# Yalnızca medya meta veri zenginleştirme (IMDB eşleme, afiş, açıklama) için.
# API uçları bu olmadan da çalışır.
TMDB_API_KEY=your-tmdb-api-key